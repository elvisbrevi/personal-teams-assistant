# Load on demand or mount as Docker secrets. Never commit real values.
ENTRA_CLIENT_SECRET=
TYPESAFE_API_KEY=
DEEPSEEK_API_KEY=
ADMIN_AUTH_KEY=
GRAPH_WEBHOOK_SECRET=
# Base64-encoded 32 random bytes. Keep stable across restarts.
STATE_ENCRYPTION_KEY=
# Every secret supports NAME_FILE=/run/secrets/name instead of NAME.
# Non-secret optional overrides:
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# TEAMS_USER_ID=
# PUBLIC_URL=https://assistant.example.com
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash
