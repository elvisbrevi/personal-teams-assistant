{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Teams Assistant",
  "version": "0.5.0",
  "identifier": "dev.personalteams.assistant",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Personal Teams Assistant",
        "width": 900,
        "height": 700,
        "minWidth": 620,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
